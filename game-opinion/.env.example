# ============ 搜索 API（拿玩家原声，可选）============
# Tavily：tavily.com 注册后 Dashboard 里复制（tvly- 开头），免费档每月 1000 次
# 不填也没关系：网页会退回「手动粘贴」模式，照样能分析。
TAVILY_API_KEY=

# ============ 分析用 LLM（DeepSeek，必填）============
# platform.deepseek.com → API Keys 创建（sk- 开头）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ 服务 ============
PORT=3100
